{
  "id": "example-image-processor",
  "name": "Example Image Processor",
  "version": "0.1.0",
  "sdkVersion": "^0.3.0",
  "type": "standalone-tool",
  "executable": "./bin/tool.js",
  "icon": "icon.png",
  "permissions": ["filesystem"],
  "author": "NodalCore Team",
  "description": "Example standalone-tool plugin demonstrating an out-of-process image processor.",
  "repository": "https://github.com/nodalcore/example-image-processor",
  "tags": ["example", "image", "processing", "standalone"],
  "contributes": {
    "configuration": {
      "title": "Image Processor",
      "properties": {
        "outputFormat": {
          "type": "string",
          "title": "Output Format",
          "enum": ["png", "jpeg", "webp"],
          "default": "png"
        },
        "quality": {
          "type": "integer",
          "title": "Quality (%)",
          "minimum": 1,
          "maximum": 100,
          "default": 85
        },
        "maxWidth": {
          "type": "integer",
          "title": "Max Width (px)",
          "minimum": 1,
          "default": 1920
        }
      }
    },
    "views": {
      "panel": [
        {
          "id": "info",
          "name": "Image Processor Info",
          "html": "panel/index.html"
        }
      ]
    }
  }
}
