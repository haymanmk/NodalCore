{
  "name": "@nodalcore/renderer",
  "version": "0.1.0",
  "description": "NodalCore React component library — shared by desktop and web apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nodalcore/registry-client": "workspace:*",
    "@nodalcore/sdk": "workspace:*",
    "@rjsf/core": "^5.24.0",
    "@rjsf/utils": "^5.24.0",
    "@rjsf/validator-ajv8": "^5.24.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
