{
  "name": "@nodalcore/sdk",
  "version": "0.3.0",
  "description": "NodalCore plugin SDK — types, interfaces, and proto definitions for plugin developers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas/connection": {
      "types": "./dist/schemas/connection.d.ts",
      "import": "./dist/schemas/connection.js",
      "require": "./dist/schemas/connection.cjs"
    }
  },
  "files": ["dist", "src/proto"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
