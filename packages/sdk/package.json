{
  "name": "@nodalcore/sdk",
  "version": "0.2.0",
  "description": "NodalCore plugin SDK — types, interfaces, and proto definitions for plugin developers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
